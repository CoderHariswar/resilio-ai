# Copy to .env and uncomment what you need. Everything defaults to Mock Mode.
# Never commit .env.

# ---------------------------------------------------------------- providers
# TELEMETRY_PROVIDER=mock          # mock | opentelemetry | datadog | sentry | prometheus
# REMEDIATION_PROVIDER=mock        # mock | github_actions | argocd | kubernetes
# NOTIFIERS=terminal               # comma list: terminal,slack,pagerduty,teams
# LLM_PROVIDER=mock                # mock | openai | anthropic | deepseek | ollama | vllm

# ---------------------------------------------------------------------- llm
# LLM_MODEL=                       # provider default if unset (vllm requires it)
# LLM_BASE_URL=                    # e.g. http://ollama:11434/v1 for air-gapped setups
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# MOCK_LLM_FAULT_RATE=0.25         # mock only: how often the first answer hallucinates

# ------------------------------------------------------------------ security
# API_TOKEN=                       # require "Authorization: Bearer ..." on approve/reject
# WEBHOOK_SECRET=                  # require HMAC-SHA256 signatures on /api/v1/webhooks/*
# PUBLIC_URL=https://resilio.example.com

# ------------------------------------------------------------------- policy
# AUTO_APPROVE_MAX_RISK=low        # none | low | medium | high | critical
# MIN_AUTO_CONFIDENCE=0.8
# CRITICAL_SERVICES=payments,auth  # +1 risk tier
# MAX_EVALUATOR_RETRIES=2
# EVALUATOR_MIN_SCORE=0.7
# HEALTH_CHECK_TIMEOUT_SECONDS=120

# --------------------------------------------------------- telemetry: datadog
# DATADOG_API_KEY=
# DATADOG_APP_KEY=
# DATADOG_SITE=datadoghq.com

# ---------------------------------------------------------- telemetry: sentry
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ------------------------------------------------------ telemetry: prometheus
# PROMETHEUS_URL=http://prometheus:9090

# --------------------------------------------- telemetry: opentelemetry/jaeger
# OTEL_QUERY_URL=http://jaeger:16686

# ----------------------------------------------------- remediation: github
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=acme/{service}
# GITHUB_ROLLBACK_WORKFLOW=rollback.yml

# ----------------------------------------------------- remediation: argocd
# ARGOCD_URL=https://argocd.example.com
# ARGOCD_TOKEN=
# ARGOCD_APP_TEMPLATE=prod-{service}

# ------------------------------------------------- remediation: kubernetes
# K8S_API_URL=https://kubernetes.default.svc
# K8S_NAMESPACE=production
# K8S_TOKEN=                       # omit in-cluster; the service account token is used

# ------------------------------------------------------------ notifications
# SLACK_WEBHOOK_URL=
# PAGERDUTY_ROUTING_KEY=
# TEAMS_WEBHOOK_URL=
